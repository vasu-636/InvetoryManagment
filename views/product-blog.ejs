<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= blogProduct.name %> — Product Detail</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <header class="navbar">
        <div class="nav-inner">
            <div class="brand">Inventory Management</div>
            <a href="/view-inventory" class="btn btn-secondary">Back to Inventory</a>
        </div>
    </header>

    <main class="container">
        <div class="form-card">
            <div style="display:flex;gap:20px;align-items:flex-start;flex-wrap:wrap">
                <img src="<%= blogProduct.imageUrl %>" alt="<%= blogProduct.name %>" style="width:360px;height:260px;object-fit:cover;border-radius:8px">
                <div>
                    <h2><%= blogProduct.name %></h2>
                    <p class="lead">₹<strong><%= blogProduct.price %></strong></p>
                    <p>Stock: <strong><%= blogProduct.quantity %></strong></p>
                    <hr>
                    <p><%= blogProduct.description %></p>
                </div>
            </div>
        </div>
    </main>

</body>
</html>